{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": [
    "nhs",
    "interop",
    "hl7",
    "fhir"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "HL7 Pipeline",
  "uid": "nhs-hl7-pipeline",
  "version": 3,
  "panels": [
    {
      "id": 1,
      "title": "Requests per second (RED: rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error ratio (RED: errors)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (service) (rate(http_requests_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 3,
      "title": "p95 request duration (RED: duration)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "PDS lookup latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (outcome, le) (rate(pds_lookup_seconds_bucket[5m])))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "title": "HL7 dead-letter rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(hl7_dlq_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "FHIR writes (success vs failure)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(fhir_write_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "PDS circuit breaker (0 closed, 1 open, 2 half-open)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "pybreaker_state{name=\"pds\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Fields dropped before FHIR",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (segment, field, reason) (rate(hl7_field_dropped_total[5m]))",
          "legendFormat": "{{segment}}-{{field}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "NHS numbers failing their check digit",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(nhs_number_invalid_total[5m]))",
          "legendFormat": "invalid",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Patient writes by identity used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (identity) (rate(patient_write_total[5m]))",
          "legendFormat": "{{identity}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Oldest dead-lettered message (seconds). Retention is 72h = 259200s",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "hl7_dlq_oldest_seconds",
          "legendFormat": "oldest message age"
        }
      ]
    }
  ]
}
